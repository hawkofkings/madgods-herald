# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_APPLICATION_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/auth/discord/callback

# Bot token (never put this in website JavaScript)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN

# Discord server and role IDs (enable Developer Mode in Discord to copy IDs)
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
MANIA_ROLE_ID=YOUR_MANIA_ROLE_ID
DEMENTIA_ROLE_ID=YOUR_DEMENTIA_ROLE_ID

# Website origin, e.g. https://yourname.github.io
FRONTEND_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=3000

# Set to true only when deploying behind Render's HTTPS proxy
TRUST_PROXY=true
